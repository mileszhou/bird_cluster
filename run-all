#!/usr/bin/env bash
# The whole pipeline end to end: label -> embed -> cluster -> post-process.
#
# Two jobs. It shows a newcomer what the project actually does, in one command
# on the shipped sample; and it is our integration test, because every stage
# here has at some point been broken by a change to a different one.
#
# ---------------------------------------------------------------------------
# IT DOES NOT CURATE, AND IT MUST NOT.
#
# Between stages a human chooses which run graduates to become the next stage's
# input, and copies it into data/. That choice is the entire content of the
# step -- "automating it would make it routine, which is the one property it
# must not have" (CLAUDE.md). A script that did it would not be running the
# pipeline, it would be deleting the judgement from it.
#
# So this stages each hand-off into $OUT/curated/ instead, and prints the `cp`
# a person would run for real. Nothing here ever writes data/. That is also why
# it defaults to ./sample_data: the demo and the test both want a dataset small
# enough to run in minutes, and neither wants the master.
#
# It is also the quickstart: on a fresh clone it creates the venv and fetches
# the sample dataset rather than telling you to. Only the two model servers are
# left to you -- starting a GPU process is a decision about a machine, not a
# step in a demo -- and it says exactly which command to run. `--no-setup`
# skips the fixing and only reports.
#
# Output goes to ./output like any other run -- one subdirectory per stage,
# label/ embed/ cluster/ -- so `./clean` archives a whole pipeline pass as one
# output_NNN_<description>/. It refuses to start on a non-empty ./output rather
# than mixing this pass into the last one.
# ---------------------------------------------------------------------------
set -euo pipefail
cd "$(dirname "$0")"

DATA=./sample_data
OUT=./output
MCS=3,5                     # suits ~100 images; 5,15,40 is the library setting
FORCE=0
SETUP=1
while [ $# -gt 0 ]; do
    case "$1" in
        --data-dir)          DATA=$2; shift 2 ;;
        --output-dir)        OUT=$2; shift 2 ;;
        --min-cluster-size)  MCS=$2; shift 2 ;;
        --force)             FORCE=1; shift ;;
        --no-setup)          SETUP=0; shift ;;
        -h|--help)
            sed -n '2,22p' "$0" | sed 's/^# \?//'
            echo
            echo "usage: ./run-all [--data-dir DIR] [--output-dir DIR] [--min-cluster-size LIST]
                 [--force] [--no-setup]"
            exit 0 ;;
        *) echo "run-all: unknown argument $1" >&2; exit 2 ;;
    esac
done

say() { printf '\n\033[1m== %s\033[0m\n' "$*"; }
die() { printf '\033[31mrun-all: %s\033[0m\n' "$*" >&2; exit 1; }

# --- preflight -------------------------------------------------------------
# Fail before doing any work rather than an hour in. Both model servers are
# separate processes on separate hosts; a down embed server used to surface as
# a stack trace after labelling had already finished.
# --- setup: make the prerequisites true rather than complain about them -----
say "setup"
if [ ! -d .venv ]; then
    if [ "$SETUP" = 1 ]; then
        echo "  no .venv -- creating it (this takes a few minutes)"
        ./venv base client cluster
    else
        die "no .venv. Run ./venv base client cluster"
    fi
else
    echo "  .venv present"
fi
source .venv/bin/activate

if [ ! -d "$DATA/jpg" ] && [ "$DATA" = "./sample_data" ]; then
    if [ "$SETUP" = 1 ]; then
        echo "  no sample dataset -- cloning it (31 MB)"
        git clone -q https://github.com/mileszhou/sample_data.git sample_data
    else
        die "no $DATA/jpg. Run: git clone https://github.com/mileszhou/sample_data.git sample_data"
    fi
else
    echo "  dataset present at $DATA"
fi

# HF_TOKEN is required, not advisory: the embed step cannot run without it on a
# machine that has not already cached DINOv3.
if [ -z "${HF_TOKEN:-}" ] && ! grep -qs HF_TOKEN .env && [ ! -s ~/.huggingface/.token ]; then
    die "HF_TOKEN is required.
       DINOv3 is gated, so without a token the embed server cannot fetch the
       backbone -- and that failure would otherwise arrive at stage 2, after
       labelling had already spent minutes.
         1. accept the licence for your account at
            https://huggingface.co/facebook/dinov3-vitb16-pretrain-lvd1689m
         2. create a token at https://huggingface.co/settings/tokens
         3. echo 'export HF_TOKEN=hf_...' >> .env
       Step 1 matters as much as step 2: without the licence the download 403s
       while the model page still resolves, which reads like a network fault."
fi
echo "  HF_TOKEN available"

say "preflight"
[ -d "$DATA/jpg" ] || die "$DATA has no jpg/ directory."
case "$(cd "$DATA" && pwd -P)" in
    "$(cd . && pwd -P)/data"|*/bird_cluster/data)
        [ "$FORCE" = 1 ] || die "refusing to run against the master dataset at $DATA.
       run-all stages hand-offs that a person is supposed to make by hand, and it
       is meant for the sample. Pass --force if you really mean it." ;;
esac
# A non-empty run root means a previous pass is sitting there. ./clean archives
# it under a new name, which is the project's way of keeping every run; silently
# writing over it would lose one and interleave two.
if [ -n "$(ls -A "$OUT" 2>/dev/null)" ] && [ "$FORCE" != 1 ]; then
    die "$OUT is not empty -- a previous run is there.
       Archive it first:  ./clean run-all-demo
       or pass --force to overwrite it."
fi

python3 - "$DATA" <<'PY' || exit 1
import sys, urllib.request
from code.lib.config import server_url
ok = True
# The same endpoints the stages themselves probe: bird_label hits
# {base}/v1/models, embed.py talks to the bare embed URL.
for name, url in (("vllm", server_url("vllm", path="/v1/models")),
                  ("embed", server_url("embed", path="/health"))):
    try:
        urllib.request.urlopen(url, timeout=5).read(1)
        print(f"  {name:<6} up    {url}")
    except Exception as exc:
        print(f"  {name:<6} DOWN  {url}  ({exc})")
        ok = False
if not ok:
    print("\n  start them and re-run:")
    print("      ./server-vllm     # in another terminal; blocks on docker logs")
    print("      ./server-embed    # add --device cpu if the GPU is busy")
sys.exit(0 if ok else 1)
PY

mkdir -p "$OUT/curated/label" "$OUT/curated/embed"
echo "  dataset $DATA -> output $OUT"

# --- 1. label --------------------------------------------------------------
say "1/5  label  (data/jpg -> CSV + sidecar keywords)"
python3 -m code.bird_label --data-dir "$DATA" --output-dir "$OUT/label" \
    --approach vllm --batch-size 8 --conf-threshold 0.6 --no-bird 0.2 \
    --run-label run-all

say "     curate  (a PERSON does this; here it is staged, not decided)"
cp "$OUT/label/bird_identification_output.csv" "$OUT/curated/label/"
echo "  for real you would choose a run and copy it yourself:"
echo "      cp output_NNN_<description>/bird_identification_output.csv data/label/"

# --- 2. embed --------------------------------------------------------------
say "2/5  embed  (JPEGs of the birds -> 768-d vectors)"
python3 -m code.embedding.embed --data-dir "$DATA" \
    --label-dir "$OUT/curated/label" --output-dir "$OUT/embed" --batch-size 32

say "     curate  (again a PERSON's choice; staged here)"
cp "$OUT/embed/embeddings.jsonl" "$OUT/curated/embed/"
echo "      cp output_NNN/embed/embeddings.jsonl data/embed/"

# --- 3. cluster ------------------------------------------------------------
say "3/5  cluster  (HDBSCAN sweep over min_cluster_size $MCS)"
python3 -m code.cluster.discover --embeddings "$OUT/curated/embed/embeddings.jsonl" \
    --output-dir "$OUT/cluster" --min-cluster-size "$MCS"

# --- 4. post-process -------------------------------------------------------
# Order matters and is enforced by the C_ marks, not by this script:
# order_assignments refuses to run before add_cluster_size.
say "4/5  post-process  (cluster_size, then the reading order)"
python3 -m tools.add_cluster_size  --output-dir "$OUT/cluster"
python3 -m tools.order_assignments --output-dir "$OUT/cluster"

# --- 5. pictures -----------------------------------------------------------
say "5/5  plots  (the ordered similarity matrix, and radial profiles)"
python3 -m tools.plot_matrix --output-dir "$OUT/cluster" \
    --embeddings "$OUT/curated/embed/embeddings.jsonl" \
    --by-cluster --warp 0.5 --order similarity --within centre || true
python3 -m tools.plot_radial --output-dir "$OUT/cluster" \
    --embeddings "$OUT/curated/embed/embeddings.jsonl" || true

say "done"
echo "  $OUT/label/bird_identification_output.csv   one row per image"
echo "  $OUT/embed/embeddings.jsonl                 one vector per bird"
echo "  $OUT/cluster/mcs*/assignments.csv           cluster per image"
echo "  $OUT/cluster/mcs*/*.png                     what the clusters look like"
echo
echo "  Nothing was written to data/. The two 'curate' steps above are the"
echo "  hand-offs a person makes; run-all only stages them so the demo can"
echo "  continue."
