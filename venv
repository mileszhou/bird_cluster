#!/usr/bin/env bash
# Build up .venv. Safe to re-run: creating an existing venv is a no-op and pip
# skips what is already satisfied, so this grows the environment incrementally
# rather than rebuilding it.
#
# Stages can be run selectively, so a non-GPU box does not have to pull torch:
#
#   ./venv                      # all stages
#   ./venv base test            # just those two
#   ./venv cluster              # add the clustering deps to an existing .venv
#
# Stages:
#   base      pip itself, .env loading, label formatting, image IO
#   client    embed.py / bird_label.py HTTP clients + OpenAI backend
#   test      pytest
#   cluster   embed/cluster/stats numeric stack (no GPU needed)
#   server    torch + transformers for embed_server.py -- GPU host only, large
#   notebook  Jupyter kernel
#   freeze    regenerate requirements.txt from what is installed (not a default)
#
# SYSTEM PREREQUISITE, `cluster` stage only:
#
#     sudo apt install python3-dev        # plus build-essential, usually present
#
# `hdbscan` publishes no aarch64 wheel, so on this box pip compiles its Cython
# extensions from source and the build needs the Python headers. Without them it
# fails deep in the wheel build with a wall of setuptools deprecation warnings
# ending in the line that actually matters:
#
#     hdbscan/_hdbscan_tree.c:38:10: fatal error: Python.h: No such file or directory
#
# Nothing else here compiles anything, so this bites only on a fresh machine and
# only on this one stage. Re-run `./venv cluster` after installing.
#
# Do not swap in `sklearn.cluster.HDBSCAN` to dodge the build: it has no
# `condensed_tree_`, which step 3 consumes (see the cluster stage below), so the
# substitution would silently remove stats.py's input.

set -u

STAGES=("$@")
if [ ${#STAGES[@]} -eq 0 ]; then
    # `freeze` is deliberately not here: it writes a tracked file, and doing
    # that as a side effect of "set my environment up" is how the last
    # requirements.txt came to describe somebody's conda environment.
    STAGES=(base client test cluster server notebook)
fi

has_stage() {
    local s
    for s in "${STAGES[@]}"; do [ "$s" = "$1" ] && return 0; done
    return 1
}

python3 -m venv .venv
printf '\n%s="%s"\n' "export PROJECT_ROOT" "$(pwd)" | tee -a .venv/bin/activate
source .venv/bin/activate

# Easiest way to set the path
#PATH=.venv/bin:$PATH   # not a good idea, better to activate the virtual environment

if has_stage base; then
    echo "== base =="
    pip install --upgrade pip
    pip install python-dotenv   # for loading environment variables from .env files
    pip install pypinyin        # for Chinese pinyin conversion
    pip install Pillow          # image IO, used by embed_server and the labeler
fi

if has_stage client; then
    echo "== client =="
    pip install requests        # embed.py -> embed_server, vllm/llama.cpp backends
    pip install openai          # for OpenAI API access
fi

if has_stage test; then
    echo "== test =="
    pip install pytest          # run from within test/: pytest lib/
fi

if has_stage cluster; then
    echo "== cluster =="
    # Fail fast on the missing headers rather than 90 lines into hdbscan's wheel
    # build. See the SYSTEM PREREQUISITE note at the top.
    py_inc=$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["include"])')
    if [ ! -f "$py_inc/Python.h" ]; then
        echo "error: $py_inc/Python.h is missing, so hdbscan cannot build its"
        echo "       Cython extensions (it ships no aarch64 wheel). Install the"
        echo "       Python headers and re-run this stage:"
        echo
        echo "           sudo apt install python3-dev"
        echo "           ./venv cluster"
        exit 1
    fi
    pip install numpy
    pip install hdbscan         # step 2 clustering; its condensed tree feeds step 3
    pip install scipy           # cluster2.py's Ward linkage -- see the note below
    pip install pandas          # condensed_tree_.to_pandas() dump
    pip install matplotlib      # tools/plot_matrix.py renders the ordered matrix
    pip install piexif          # export_seriated rewrites EXIF without re-encoding
    pip install huggingface_hub # predict_taxa fetches the checklist -- note below

    # scipy and huggingface_hub are named here even though something else always
    # drags them in on a full install: scipy arrives with hdbscan, and
    # huggingface_hub with transformers. Both of those are stages a GPU-less box
    # deliberately skips, and then `./run-cluster2` and `python3 -m
    # tools.predict_taxa` fail on an import nothing ever asked for. A dependency
    # that works by luck is a dependency that breaks on the first lean install.
fi

if has_stage server; then
    echo "== server (large; GPU host only) =="
    pip install torch transformers datasets
    pip install torchvision      # transformers' AutoImageProcessor requires it
    pip install open_clip_torch  # BioCLIP; not reachable through AutoModel
    pip install fastapi uvicorn  # embed_server.py HTTP surface
fi

if has_stage notebook; then
    echo "== notebook =="
    pip install ipykernel       # for Jupyter notebook support
fi

if has_stage freeze; then
    echo "== freeze =="
    # This file is the ground truth for what gets installed; requirements.txt is
    # a snapshot of what that produced, kept as a compatibility guard for the
    # day a major version jump breaks the environment and a known-good set is
    # wanted. So it is generated *from* here rather than maintained beside it,
    # and regenerating is a deliberate act with a commit behind it.
    #
    # The nvidia-* and triton wheels are dropped: they are transitive CUDA
    # dependencies that torch resolves for itself against whatever CUDA is
    # present, and pinning them makes the file installable only on a box with
    # this exact toolkit -- the opposite of a rescue.
    {
        echo "# Pinned snapshot of a known-good environment. NOT the install path."
        echo "#"
        echo "#     ./venv                       <- the install path, and the ground truth"
        echo "#     pip install -r requirements.txt   <- only when versions have drifted"
        echo "#                                          far enough to break something"
        echo "#"
        echo "# Regenerate with \`./venv freeze\` after a deliberate upgrade, never as a"
        echo "# side effect. \`./venv\` decides what is installed; this records what that"
        echo "# produced, so the two can disagree only until someone re-freezes."
        echo "#"
        echo "# Frozen on $(uname -s)/$(uname -m), $(python3 -V 2>&1), $(date +%Y-%m-%d)."
        echo "# Portable on purpose. pip freeze reports torch by version alone, without"
        echo "# the +cuNNN local tag it was built with, so these pins resolve against"
        echo "# plain PyPI and each machine gets the build matching its own platform."
        echo "# Transitive nvidia-*/triton wheels are dropped for the same reason: torch"
        echo "# pulls the right ones for the CUDA it finds, and pinning the set from"
        echo "# this box would make the file installable only on a box exactly like it."
        echo "#"
        echo "# This is what is *installed*, which is a superset of what ./venv installs"
        echo "# if anything was ever pip-installed by hand. Check a diff before"
        echo "# committing a re-freeze, the same as any other generated file."
        echo "#"
        pip freeze | grep -viE '^(nvidia-|triton)'
    } > requirements.txt
    echo "wrote requirements.txt ($(grep -cv '^#' requirements.txt) pins)"
fi

# pip install -e ~/projects/vllm

# environment variables
source _env
