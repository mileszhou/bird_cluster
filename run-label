#!/usr/bin/env bash
set -euo pipefail

# Every path in this project hangs off $PROJECT_ROOT. Set here from the script's
# own location if the caller has not already set it, and exported so python and
# any child process see the same answer. This script had no cd at all and only
# worked when invoked from the repository root.
export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "$0")" && pwd)}"
cd "$PROJECT_ROOT"
[ -d .venv ] && source .venv/bin/activate

# `set -u` is right for this script and wrong for someone else's config file.
# .env is user-authored and may reasonably contain a guard like
#     if [ -z "$OPENAI_API_KEY" ]; then ...
# which under nounset aborts on the very variable it is checking for -- so the
# check for a missing key becomes the thing that fails when the key is missing,
# with an error naming a line the user did not think of as code. Relax it for
# the source, restore it immediately.
set +u
[ -f .env ] && source .env
set -u
python3 -m code.bird_label \
   --conf-threshold 0.6 --no-bird 0.2 \
   --approach vllm \
   --batch-size 16 \
   --model Qwen/Qwen3-VL-32B-Instruct \
   "$@"
