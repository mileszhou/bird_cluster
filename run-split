#!/bin/bash
# Propose collision-free split points for each year of the XMP library.
#
# SUPERSEDED. Splitting existed to make a *flat* jpg export addressable by
# filename. The Lightroom export now mirrors the library's folder structure, so
# a photo is keyed by trip folder + stem and filename collisions no longer
# matter. Kept because the analysis is still the way to answer "which frame
# numbers repeat, and where" -- but nothing downstream consumes split_plan.csv.
#
# Read-only; writes the report and CSV into project/reports/.
# Run ./run-dedup first -- duplicates read as collisions and force phantom cuts.
cd "$(dirname "$0")"
[ -d .venv ] && source .venv/bin/activate
python3 tools/analyze_wraparound.py --xmp-dir ./data/xmp "$@"
