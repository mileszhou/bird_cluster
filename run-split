#!/bin/bash
# Propose collision-free split points for each year of the unsplit XMP library.
# Read-only; writes the report and CSV into project/reports/.
# Run ./run-dedup first -- duplicates read as collisions and force phantom cuts.
cd "$(dirname "$0")"
[ -d .venv ] && source .venv/bin/activate
python3 tools/analyze_wraparound.py --xmp-dir ./data/xmp0 "$@"
