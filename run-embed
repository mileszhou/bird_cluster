#!/bin/bash
# Step 1: embed bird photos via the embed server (see run-server-embed).
#
# The guide is a curated labelling run's CSV (--label-dir), not the sidecar
# tree: one row per exported image, keyed by the path under data/jpg. That is
# what lets the 569 birds with no sidecar be embedded at all.
#
# The whole bird set by default. Narrow with a manifest (--include-from /
# --exclude-from, see manifests/) and check the scope first with --dry-run.
# Every path in this project hangs off $PROJECT_ROOT. Set here from the script's
# own location if the caller has not already set it, and exported so python and
# any child process see the same answer.
export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "$0")" && pwd)}"
cd "$PROJECT_ROOT"
[ -d .venv ] && source .venv/bin/activate
python3 -m code.embedding.embed \
   --output-dir ./output/embed \
   --batch-size 32 \
   "$@"
