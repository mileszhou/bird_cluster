#!/bin/bash
# Start a fresh output/ by archiving the current one -- nothing is deleted.
#
# This used to be `rm -rf output/`, which threw away the only record of what a
# run had decided: `bird_identification_output.csv` carries prior_category /
# prior_label, the sole copy of the labels a previous pass had left, and
# `raw/` holds sidecars that may not have been rsynced into the library yet.
# Both are gitignored, so a delete was unrecoverable.
#
#   ./clean                  ->  output/ becomes output_001/
#   ./clean first-full-run   ->  output/ becomes output_001_first-full-run/
#
# The index is one beyond the highest already present, so archives stay in run
# order. Rename one later to add a description -- `output_001_qwen32b` -- and
# the numbering still works, since only the leading digits are read.
# `output*/` is gitignored, so every archive is ignored too.
set -euo pipefail
cd "$(dirname "$0")"

# Highest NNN among output_NNN..., zero or nothing if there are none.
highest_index() {
    local max=0 name digits
    for path in output_*; do
        [ -d "$path" ] || continue
        name=${path#output_}
        digits=${name%%[!0-9]*}          # leading run of digits, "" if none
        [ -n "$digits" ] || continue
        digits=$((10#$digits))           # 010 is ten, not an octal error
        (( digits > max )) && max=$digits
    done
    printf '%d' "$max"
}

slug() {   # a description safe to put in a directory name
    printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//'
}

if [ ! -d output ]; then
    mkdir -p output
    echo "no output/ to archive; created an empty one"
    exit 0
fi

if [ -z "$(ls -A output)" ]; then
    echo "output/ is already empty; nothing to archive"
    exit 0
fi

dest=$(printf 'output_%03d' "$(( $(highest_index) + 1 ))")
if [ $# -gt 0 ] && [ -n "$(slug "$*")" ]; then
    dest="${dest}_$(slug "$*")"
fi

# Refuse rather than merge into something that already exists.
[ -e "$dest" ] && { echo "error: $dest already exists; move it aside first" >&2; exit 1; }

rows=""
csv=output/bird_identification_output.csv
[ -f "$csv" ] && rows=$(( $(wc -l < "$csv") - 1 ))
size=$(du -sh output | cut -f1)

mv output "$dest"
mkdir output

echo "archived output/ -> $dest/  ($size${rows:+, $rows labelled})"
echo "fresh output/ ready"
# raw/ is a full copy of the sidecar tree and dominates the size. Once an
# archive's labels have been rsynced into the library it is safe to drop just
# that subdirectory, keeping the CSV, log, args.json and checkpoint.
[ -d "$dest/raw" ] && echo "note: $dest/raw is $(du -sh "$dest/raw" | cut -f1) — droppable once rsynced"
exit 0
