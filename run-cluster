#!/bin/bash
# Step 2: HDBSCAN over the curated embeddings.
#
# Each --min-cluster-size gets its own output directory; nothing is overwritten,
# because how the structure changes across the sweep is the finding.
cd "$(dirname "$0")"
[ -d .venv ] && source .venv/bin/activate
python3 -m code.cluster.discover \
   --embeddings ./data/embed/embeddings.jsonl \
   --output-dir ./output/cluster \
   --min-cluster-size 5,15,40 \
   "$@"
